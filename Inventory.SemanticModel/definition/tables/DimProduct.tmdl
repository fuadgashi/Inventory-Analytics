/// The product catalogue: one row per product, with its brand, division and pack sizes.
table DimProduct
	lineageTag: 9d0ac95f-1924-4b37-aebe-e0b154c91996

	/// Product code. Text on purpose: Power BI offers the slicer search box only on a text column. FactInvoiceLine[ProductId] and FactStock[ProductId] are text for the same reason and must stay in step with it.
	column ProductId
		dataType: string
		isKey
		isAvailableInMdx: false
		lineageTag: fb644f05-9124-4414-ae8f-162ac61f1209
		summarizeBy: none
		sourceColumn: ProductId

		annotation SummarizationSetBy = Automatic

	/// Product name as it appears in the catalogue. Sorted by ProductSortOrder.
	column ProductName
		dataType: string
		isAvailableInMdx: false
		lineageTag: 49d80bc8-d73c-49dc-9ffe-6cbd5ad2eab1
		isDefaultLabel
		summarizeBy: none
		sourceColumn: ProductName
		sortByColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	/// Product division. Joins to DimDivision.
	column DivisionId
		dataType: int64
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 56eaa109-0b7f-42c0-9f0d-f9e6bbd5b58a
		summarizeBy: none
		sourceColumn: DivisionId

		annotation SummarizationSetBy = Automatic

	/// Units per case. A pack-size conversion factor, not a quantity: never aggregate it. Stock Packs divides stock by it; Stock Pallets by it times CasesPerPallet.
	column UnitsPerCase
		dataType: int64
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 8cc30e49-ca62-4234-80fc-4dba6c2ae705
		summarizeBy: none
		sourceColumn: UnitsPerCase

		annotation SummarizationSetBy = Automatic

	/// Units per trade case. A pack-size conversion factor, not a quantity: never aggregate it.
	column UnitsPerTradeCase
		dataType: int64
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 527489ec-62fa-48fc-b300-17ae646ea5b2
		summarizeBy: none
		sourceColumn: UnitsPerTradeCase

		annotation SummarizationSetBy = Automatic

	/// Cases per pallet. A pack-size conversion factor, not a quantity: never aggregate it.
	column CasesPerPallet
		dataType: double
		isAvailableInMdx: false
		lineageTag: e96f0359-6a05-4abd-aaa2-a0705a8f2adb
		summarizeBy: none
		sourceColumn: CasesPerPallet

		annotation SummarizationSetBy = Automatic

	/// Brand owner the product is booked under. Usually, not always, the company it is bought from.
	column Brand
		dataType: string
		isAvailableInMdx: false
		lineageTag: fb757a6a-fec3-4cad-ade4-94b974258829
		summarizeBy: none
		sourceColumn: Brand

		annotation SummarizationSetBy = Automatic

	/// TRUE for products that count toward reporting. FactInvoiceLine already leaves the others out at the source, so no measure filters on it; it stays for reading the catalogue.
	column CountsTowardSales
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: c4dd1bb1-e150-4fdb-8f23-bf614dd3e1f1
		summarizeBy: none
		sourceColumn: CountsTowardSales

		annotation SummarizationSetBy = Automatic

	/// Net weight per unit in kilograms. A per-unit attribute: never aggregate it.
	column NetWeightKg
		dataType: double
		isAvailableInMdx: false
		lineageTag: cb042612-d3a6-4fd4-9a3d-0e6163916621
		summarizeBy: none
		sourceColumn: NetWeightKg

		annotation SummarizationSetBy = Automatic

	/// Gross weight per unit in kilograms. A per-unit attribute: never aggregate it.
	column GrossWeightKg
		dataType: double
		isAvailableInMdx: false
		lineageTag: b13faa8c-dcd4-4083-8f08-8a6e99d38ed0
		summarizeBy: none
		sourceColumn: GrossWeightKg

		annotation SummarizationSetBy = Automatic

	/// TRUE for goods; FALSE for service and allowance lines, which carry no real cost or selling price and are kept out of margin and cost.
	column IsGoods
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: b79215c3-711b-4380-ae4d-776cd51c0f56
		summarizeBy: none
		sourceColumn: IsGoods

		annotation SummarizationSetBy = Automatic

	/// Code of the brand owner. Text, so its dropdown slicers offer a search box.
	column BrandId
		dataType: string
		isAvailableInMdx: false
		lineageTag: ac9862d9-c6da-4487-8d8a-10649917da76
		summarizeBy: none
		sourceColumn: BrandId

		annotation SummarizationSetBy = Automatic

	/// Display order of ProductName, from the source: one position per product name.
	column ProductSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 77f9afd5-e4b4-4868-90e1-99d579dbe704
		summarizeBy: none
		sourceColumn: ProductSortOrder

		annotation SummarizationSetBy = Automatic

	partition DimProduct = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // The product catalogue with brand, division, pack sizes and display order.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    CAST(p.ProductId AS VARCHAR(20)) AS ProductId,
				                    p.ProductName,
				                    p.SortOrder AS ProductSortOrder,
				                    p.DivisionId,
				                    CAST(p.BrandId AS VARCHAR(20)) AS BrandId,
				                    b.BrandName AS Brand,
				                    p.UnitsPerCase,
				                    p.UnitsPerTradeCase,
				                    p.CasesPerPallet,
				                    p.NetWeightKg,
				                    p.GrossWeightKg,
				                    p.IsGoods,
				                    p.CountsTowardSales
				                FROM inv.Product p
				                LEFT JOIN inv.Brand b
				                    ON b.BrandId = p.BrandId
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"ProductId"}, true),
				    Typed = Table.TransformColumnTypes(Keyed, {{"IsGoods", type logical}, {"CountsTowardSales", type logical}})
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
