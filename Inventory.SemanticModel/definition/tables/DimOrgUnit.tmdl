/// Organisational units: the warehouses that hold stock, and the other units documents are issued from. Not every unit is a location.
table DimOrgUnit
	lineageTag: 14196e3d-4d6e-45cd-ba17-aec4bd91d1e9

	/// Organisational unit code. Joins FactStock[WarehouseId] and FactInvoiceLine[OrgUnitId]; whole number, like both.
	column OrgUnitId
		dataType: int64
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: e0e1af3f-2e31-4862-994c-9c1bfbcda66f
		summarizeBy: none
		sourceColumn: OrgUnitId

		annotation SummarizationSetBy = Automatic

	/// Organisational unit name. Sorted by OrgUnitSortOrder.
	column OrgUnitName
		dataType: string
		isAvailableInMdx: false
		lineageTag: b3b1ccd0-1a1d-49c7-b9ab-e4cffe111bc8
		isDefaultLabel
		summarizeBy: none
		sourceColumn: OrgUnitName
		sortByColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic

	/// Display order of OrgUnitName, from the source: one position per unit name.
	column OrgUnitSortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f9e60bc7-bc5b-4bbe-80c1-e85e3e9fd436
		summarizeBy: none
		sourceColumn: OrgUnitSortOrder

		annotation SummarizationSetBy = Automatic

	partition DimOrgUnit = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Organisational units: warehouses and the other units documents are issued from.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    o.OrgUnitId,
				                    o.OrgUnitName,
				                    o.SortOrder AS OrgUnitSortOrder
				                FROM inv.OrgUnit o
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"OrgUnitId"}, true)
				in
				    Keyed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
