/// Product divisions: the commercial book a product is sold under, with the distribution-cost rate the stock valuation reads.
table DimDivision
	lineageTag: f8550648-42f1-47d4-8a91-7c239957fc56

	/// Division code.
	column DivisionId
		dataType: int64
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 44765a74-77ae-40f0-aba2-696483e3221e
		summarizeBy: none
		sourceColumn: DivisionId

		annotation SummarizationSetBy = Automatic

	/// Division name.
	column DivisionName
		dataType: string
		isAvailableInMdx: false
		lineageTag: e91087ce-94a6-413f-be93-cae5f41e6d11
		isDefaultLabel
		summarizeBy: none
		sourceColumn: DivisionName

		annotation SummarizationSetBy = Automatic

	/// Distribution cost as a share of the net selling price. Net realisable value deducts it (Stock Carrying Amount). A rate: never aggregate it.
	column DistributionCostRate
		dataType: double
		formatString: 0.0%
		isAvailableInMdx: false
		lineageTag: 63bacc49-47ae-4952-ad84-4061e02bea4b
		summarizeBy: none
		sourceColumn: DistributionCostRate

		annotation SummarizationSetBy = Automatic

	partition DimDivision = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Product divisions.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    d.DivisionId,
				                    d.DivisionName
				                FROM inv.Division d
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"DivisionId"}, true),
				    // The distribution-cost rate the stock valuation deducts from the net selling price.
				    // A sample value, the same for every division.
				    WithRate = Table.AddColumn(Keyed, "DistributionCostRate", each 0.08, type number)
				in
				    WithRate
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
