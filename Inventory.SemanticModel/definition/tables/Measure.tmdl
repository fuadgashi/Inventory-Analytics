	/// Stock at list price expiring inside the selected interval, or span of intervals: it keeps the lots whose days to expiry fall between the lowest DaysFrom and the highest DaysTo in scope, so several adjacent intervals give one continuous span. Shelf-life warehouses only. Value.
	measure 'Stock Value by Expiry Interval' =
			
			VAR _min = MIN( ExpiryInterval[DaysFrom] )
			VAR _max = MAX( ExpiryInterval[DaysTo] )
			RETURN
			    CALCULATE(
			        [Stock List Value],
			        KEEPFILTERS( FactStock[InExpiryScope] = TRUE ),
			        KEEPFILTERS( FactStock[DaysToExpiry] >= _min ),
			        KEEPFILTERS( FactStock[DaysToExpiry] <= _max )
