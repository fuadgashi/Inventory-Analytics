	/// Weeks of stock cover by value: stock at list price over the twelve-month average weekly sales at the regular price, both with VAT and before discounts, so the two sides share one price basis. Weeks.
	measure 'Stock Weeks of Cover Value' =
			-- Stock List Value is priced at the list price, before discounts; dividing it by net sales
			-- (after discounts) stretched the cover by the average discount. The regular price on
			-- the invoice is the sales-side twin of the list price.
			-- Per working day (calendar) since the first sale, not per day WITH a sale: counting only
			-- the days with a sale would read a rarely sold article many times its real daily rate,
			-- and its cover far too short.
			DIVIDE(
			    [Stock List Value],
			    AvgDay( [Sales Selling Price Twelve Months] ) * [Working Days per Week]
			)
		formatString: #,0.00
		displayFolder: Stock\Balance
		lineageTag: 2d3f2f38-2e74-4ae6-9d5d-e3d76edc44a1

	/// Stock at cost of products with no sale in twelve months. Value; a tooltip view of Stock Without Sales Twelve Months.
	measure 'Stock Without Sales' =
			
			[Stock Without Sales Twelve Months]
		displayFolder: Lookup\Stock
