	/// Stock at cost of products with no sale in the last twelve months: slow-moving stock, shown separately for a provision decision. It stays inside Stock Cost Value, and at cost in Stock Carrying Amount. Value.
	measure 'Stock Without Sales Twelve Months' =
			
			-- "No sale in 12 months" = no 12-month net price over any warehouse, the same test that
			-- leaves these articles at cost in Stock Carrying Amount, so the two always agree.
			SUMX(
			    TREATAS( VALUES( FactStock[ProductId] ), DimProduct[ProductId] ),
			    VAR _price = CALCULATE( [Net Price ex VAT Twelve Months], REMOVEFILTERS( DimOrgUnit ) )
			    VAR _cost = CALCULATE( [Stock Cost Value] )
			    RETURN
			        IF( ISBLANK( _price ), _cost )
			)
		formatString: #,0
		displayFolder: Calculation Roots\Stock
		lineageTag: fb791e3b-49f1-46ea-b2e0-bdecb72be243

	/// Stock write-down under IAS 2: cost (Stock Cost Value) less carrying amount (Stock Carrying Amount), expired lots included. Value; positive is a write-down.
	measure 'Stock Write-Down' =
			
			[Stock Cost Value] - [Stock Carrying Amount]
		formatString: #,0
		displayFolder: Calculation Roots\Stock
		lineageTag: ad5a2011-5b98-4043-bdad-baa06da387fd

	/// Theme colour name for a brand's at-risk stock: the colour of the interval that holds the largest share of its at-risk value, so it matches the horizon chart. Bar length carries the amount; the colour carries how soon.
	measure 'Supplier Expiry Risk Color' =
			VAR _expired = CALCULATE( [Stock Value by Expiry Interval], ExpiryInterval[SortOrder] = 1 ) + 0
			VAR _bucket_30 = CALCULATE( [Stock Value by Expiry Interval], ExpiryInterval[SortOrder] = 2 ) + 0
			VAR _bucket_60 = CALCULATE( [Stock Value by Expiry Interval], ExpiryInterval[SortOrder] = 3 ) + 0
			VAR _bucket_90 = CALCULATE( [Stock Value by Expiry Interval], ExpiryInterval[SortOrder] = 4 ) + 0
			VAR _largest = MAX( MAX( _expired, _bucket_30 ), MAX( _bucket_60, _bucket_90 ) )
			RETURN
			    IF(
			        _largest <> 0,
			        RagColor(
			            SWITCH(
			                TRUE(),
			                -- Ties fall to the more urgent interval, which is the safe direction.
			                _expired = _largest, -1,
			                _bucket_30 = _largest, 0,
			                _bucket_60 = _largest, 0,
			                1
			            ),
			            0
			        )
			    )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 826e7ccd-4e65-400a-ab56-3ddac4ac6f9c

		annotation PBI_FormatHint = {"isText":true}

	/// Derived unit cost of a product, without VAT: the twelve-month purchase cost after discounts, else the twelve-month cost on sales lines, else the cost on its last purchase or sale. One cost per product, whatever the warehouse. Prices the stock the source holds no cost for, and checks the cost it does hold. Value per unit.
	measure 'Unit Cost Derived' =
			
			VAR _purchases_12m =
			    CALCULATE( TwelMonth( [Purchase Net Price ex VAT] ), REMOVEFILTERS( DimOrgUnit ) )
			VAR _sales_12m =
			    CALCULATE( [Cost Price Twelve Months], REMOVEFILTERS( DimOrgUnit ) )
			VAR _last_date =
			    CALCULATE(
			        MAX( FactInvoiceLine[Date] ),
			        REMOVEFILTERS( DimOrgUnit ),
			        REMOVEFILTERS( DimDate ),
			        FILTER( ALL( DimDocumentType[IsPurchase], DimDocumentType[IsSalesOut] ), DimDocumentType[IsPurchase] || DimDocumentType[IsSalesOut] )
			    )
			VAR _last_cost =
			    CALCULATE(
			        COALESCE( [Purchase Net Price ex VAT], [Cost Price] ),
			        REMOVEFILTERS( DimOrgUnit ),
			        REMOVEFILTERS( DimDate ),
			        DimDate[Date] = _last_date
			    )
			RETURN
			    COALESCE( _purchases_12m, _sales_12m, _last_cost )
		formatString: #,0.00
		displayFolder: Stock\Cost Check
		lineageTag: 3521210d-e2e3-4a48-8a23-6a1c3a4a7103

	/// The source's running average unit cost, without VAT, weighted by the stock quantity it applies to: the IAS 2 cost the stock is booked at. Blank where no cost is held. Value per unit.
	measure 'Unit Cost ERP' =
			
			DIVIDE(
			    SUMX( FactStock, FactStock[QuantityOnHand] * FactStock[UnitCost] ),
			    CALCULATE( SUM( FactStock[QuantityOnHand] ), KEEPFILTERS( NOT ISBLANK( FactStock[UnitCost] ) ) )
			)
		formatString: #,0.00
		displayFolder: Stock\Cost Check
		lineageTag: b642c6cb-7407-4c48-8204-ddf644d515a9

	/// Source unit cost over derived unit cost. Above 2 or below 0.5 the source cost is listed as an exception to correct. A ratio.
	measure 'Unit Cost Ratio ERP/Derived' =
			
			DIVIDE( [Unit Cost ERP], [Unit Cost Derived] )
		formatString: #,0.00
		displayFolder: Stock\Cost Check
		lineageTag: 828acaad-d2f4-4c5d-8101-b62f5db1d415

	/// Working days after today up to the end of the period in the date slicers, from the calendar. Days.
	measure 'Working Days Remaining' =
			VAR _end = MAX( DimDate[Date] )
			RETURN
				-- Working days come from the calendar (DimDate[Working Day]); the rule lives in the DimDate query
				-- KEEPFILTERS: the days stay inside the date slicers' selection the visual already has
				CALCULATE(
					SUM( DimDate[Working Day] ),
					KEEPFILTERS( DimDate[Date] > TODAY() ),
					KEEPFILTERS( DimDate[Date] <= _end )
				)
		formatString: 0
		displayFolder: Calendar\Working Days
		lineageTag: 54d474b5-e5eb-4cc4-ace8-5693eb4bee3d

		changedProperty = IsHidden

	/// Share of calendar days that are working days, from the calendar. A ratio that puts a span in calendar days, such as shelf life, on the same basis as a cover in working days.
	measure 'Working Days Share' =
			DIVIDE(
				CALCULATE( SUM( DimDate[Working Day] ), REMOVEFILTERS( DimDate ) ),
				CALCULATE( COUNTROWS( DimDate ), REMOVEFILTERS( DimDate ) )
			)
		formatString: 0.0000
		isHidden
		displayFolder: Calendar\Working Days
		lineageTag: 5fd47979-30d7-4699-82dd-54d2a7568915

	/// Working days in a week, from the calendar. Days. Turns a per-day average into a weekly one.
	measure 'Working Days per Week' = CALCULATE( DISTINCTCOUNT( DimDate[Day Week] ), REMOVEFILTERS( DimDate ), DimDate[Working Day] = 1 )
		formatString: 0
		isHidden
		displayFolder: Calendar\Working Days
		lineageTag: 53664b98-32e2-497a-bbf2-fd6b0b363640

	/// Change in net sales: this year to date against the prior year up to the same day, (actual - prior) / prior. Shown with an arrow, up above zero and down below.
	measure 'Index Sales Net Price Actual/Prior YTD' =
			
			VAR _actual_year = YearToDay([Sales Net Price])
			VAR _prior_year_to_date   = YearToDay(PrevYear([Sales Net Price]))
			RETURN
			IndexDif(_actual_year, _prior_year_to_date)
		displayFolder: Sales\Net Price
		lineageTag: 36cc9859-30a4-414e-9a26-cfa5bcf532a9

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

		changedProperty = IsHidden

	/// Change in quantity sold: this year to date against the prior year up to the same day, (actual - prior) / prior. Shown with an arrow, up above zero and down below.
	measure 'Index Sales Quantity Actual/Prior YTD' =
			
			IndexDif([Sales Quantity Actual Year], [Sales Quantity Prior Year YTD])
		displayFolder: Sales\Quantity
		lineageTag: d7d656e7-a804-4bd9-9f6b-7a9b401282fd

		formatStringDefinition = IndexFormat(SELECTEDMEASURE(), 0)

		annotation RagColor = UpIsGood

	/// Theme colour name for [Index Sales Quantity Actual/Prior YTD]: good when it rises, neutral at 0, blank when it is blank. Generated by scripts/rag_colors.py from the RagColor annotation on [Index Sales Quantity Actual/Prior YTD]; edit the annotation, not this measure.
	measure 'Index Sales Quantity Actual/Prior YTD Color' = RagColor( [Index Sales Quantity Actual/Prior YTD], 0 )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 14609b45-e7d8-4df5-85b8-e4872368a30c

		annotation PBI_FormatHint = {"isText":true}

	/// Net sales: quantity times the net price the customer pays, after discounts and with VAT, on sales-out documents. The one sales figure of the model: call it, never rebuild it. Value.
	measure 'Sales Net Price' =
			
			CALCULATE(
			    SUMX(
			        FactInvoiceLine,
			        FactInvoiceLine[Quantity] * FactInvoiceLine[NetPrice]),
			    DimDocumentType[IsSalesOut] = TRUE
			)
		displayFolder: Calculation Roots\Sales
		lineageTag: 8b83bc41-5729-4d66-a2cc-011fb26c9273

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// Net sales this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Value.
	measure 'Sales Net Price Actual Year' =
			
			YearToDay([Sales Net Price])
		displayFolder: Sales\Net Price
		lineageTag: f40e9701-a9b9-4c04-9ae5-1a5b19f4633e

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Average monthly net sales over the rolling twelve months, per month of working days since the product's first sale in that window (AvgDay times Working Days per Month). Value per month.
	measure 'Sales Net Price Monthly Average' =
			-- Per month of working days (calendar) since the first sale, not per month WITH a sale:
			-- counting only the months with a sale would read a rarely sold article as if it sold
			-- every month, and its cover far too short.
			AvgDay( [Sales Net Price Twelve Months] ) * [Working Days per Month]
		displayFolder: Sales\Net Price
		lineageTag: 838d4a9b-3303-41c2-b6c6-d21738b0ddbd

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// Net sales in the prior year: the date slicers' window one year back, inside last calendar year. Value.
	measure 'Sales Net Price Prior Year' =
			
			PrevYear([Sales Net Price])
		displayFolder: Sales\Net Price
		lineageTag: efed6e2b-2ab6-4806-806a-1e51593e204c

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Net sales in the prior year up to the same day: the date slicers' window cut at today, one year back. Value.
	measure 'Sales Net Price Prior Year YTD' =
			
			YearToDay([Sales Net Price Prior Year])
		displayFolder: Sales\Net Price
		lineageTag: 615335b3-f4a8-4ac4-afe0-b79184aa06bf

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Net sales over the rolling twelve months: from twelve months before today, within the date slicers. Value.
	measure 'Sales Net Price Twelve Months' =
			
			TwelMonth([Sales Net Price])
		displayFolder: Sales\Net Price
		lineageTag: 72bc625f-7801-475a-8358-cef6f08b1f8f

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// The row's share of all net sales over the rolling twelve months, every filter removed. Percentage.
	measure 'Sales Net Price Twelve Months Share' = ```
			DIVIDE(
						[Sales Net Price Twelve Months],
						CALCULATE(
							[Sales Net Price Twelve Months],
							ALL()
						),
						0
					)
				
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales\Share
		lineageTag: dc81f5e1-d98a-4c0c-a986-31d5587a89f0

		changedProperty = IsHidden

	/// Average weekly net sales over the rolling twelve months, per week of working days since the product's first sale in that window (AvgDay times Working Days per Week). Value per week.
	measure 'Sales Net Price Weekly Average' =
			-- Per week of working days (calendar) since the first sale, not per week WITH a sale:
			-- counting only the weeks with a sale would read a rarely sold article as if it sold
			-- every week, and its cover far too short.
			AvgDay( [Sales Net Price Twelve Months] ) * [Working Days per Week]
		displayFolder: Sales\Net Price
		lineageTag: f919287f-e253-47df-9a14-37e9d01ffe1f

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Working days this year before today, within the date slicers, from the calendar. Days.
	measure 'Working Days Passed' =
			VAR _year_start = DATE( YEAR( TODAY() ), 1, 1 )
			RETURN
				-- Working days come from the calendar (DimDate[Working Day]); the rule lives in the DimDate query
				-- KEEPFILTERS: the days stay inside the date slicers' selection the visual already has
				CALCULATE(
					SUM( DimDate[Working Day] ),
					KEEPFILTERS( DimDate[Date] >= _year_start ),
					KEEPFILTERS( DimDate[Date] < TODAY() )
				)
		formatString: 0
		displayFolder: Calendar\Working Days
		lineageTag: 0fa3e801-adf4-4718-b201-25010c45038c

		changedProperty = IsHidden

	/// Average working days in a month, from the calendar: its working days over its months. Days. Turns a per-day average into a monthly one.
	measure 'Working Days per Month' =
			DIVIDE(
				CALCULATE( SUM( DimDate[Working Day] ), REMOVEFILTERS( DimDate ) ),
				CALCULATE( DISTINCTCOUNT( DimDate[YearMonthKey] ), REMOVEFILTERS( DimDate ) )
			)
		formatString: 0.00
		isHidden
		displayFolder: Calendar\Working Days
		lineageTag: 358b0e5a-def4-4009-aafa-19dfbaf23f23

	partition Measure = m
		mode: import
		queryGroup: Model
		source =
				let
				    // Query group: Model
				    // Generic measure-table scaffold - an empty table that hosts measures
				    // only. Zero columns by design: with no visible columns and at least
				    // one measure, Power BI shows the calculator icon and pins the table
				    // to the top of the Fields pane.
				    Source = #table({}, {})
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

