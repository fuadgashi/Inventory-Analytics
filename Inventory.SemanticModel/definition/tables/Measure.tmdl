	/// Quantity sold over the rolling twelve months: from twelve months before today, within the date slicers. Units.
	measure 'Sales Quantity Twelve Months' =
			
			TwelMonth([Sales Quantity])
		displayFolder: Sales\Quantity
		lineageTag: 38e4e615-0817-4f4d-84c5-9893706d9aa6

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// Sales at the regular selling price, with VAT and before discounts, on sales-out documents. Value.
	measure 'Sales Selling Price' =
			
			CALCULATE(
			    SUMX(
			        FactInvoiceLine,
			        FactInvoiceLine[Quantity] * FactInvoiceLine[DocumentPrice]),
			    DimDocumentType[IsSalesOut] = TRUE
			)
		displayFolder: Calculation Roots\Sales
		lineageTag: 0120fbab-ad50-4783-8184-1f0ed9c7f000

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// Sales at the regular selling price, with VAT and before discounts, over the rolling twelve months. Value.
	measure 'Sales Selling Price Twelve Months' =
			
			TwelMonth([Sales Selling Price])
		displayFolder: Sales\Selling Price
		lineageTag: 498d08ee-9dd0-4c8d-a022-c3022a160c0d

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// Remaining shelf life of the stock not yet expired: days to expiry, weighted by quantity, over the lots with zero or more days left. Days. Blank when every lot has expired or none carries a date, and blank with only Expired selected in the Band slicer.
	measure 'Shelf Life Days' =
			-- Weighted by quantity, so a 1-unit lot weighs less than a 10,000-unit one.
			-- Expired lots are left out: averaged in, a lot weeks past its date beside fresh lots reads
			-- as a healthy shelf life. NOT ISBLANK guards the >= 0 test, which a blank
			-- date would pass.
			VAR _selection = VALUES( ExpiryRiskBand[Band] )
			VAR _show_expired = "Expired" IN _selection
			VAR _show_fresh = COUNTROWS( EXCEPT( _selection, { "Expired" } ) ) > 0
			RETURN
			    IF(
			        _show_fresh,
			        CALCULATE(
			            DIVIDE( SUMX( FactStock, FactStock[QuantityOnHand] * FactStock[DaysToExpiry] ), SUM( FactStock[QuantityOnHand] ) ),
			            KEEPFILTERS( NOT ISBLANK( FactStock[DaysToExpiry] ) && FactStock[DaysToExpiry] >= 0 ),
			            KEEPFILTERS( FactStock[InExpiryScope] = TRUE )
			        )
			    )
		formatString: #,0
		displayFolder: Stock\Balance
		lineageTag: 46f5b244-5644-42ec-b8b5-411755bb3d63

	/// Share of stock value, in the shelf-life warehouses, that is expired or expires within 90 days. Percentage.
	measure 'Stock At Risk %' =
			
			VAR _stock =
			    CALCULATE( [Stock List Value], KEEPFILTERS( FactStock[InExpiryScope] = TRUE ) )
			RETURN
			    DIVIDE( [Stock Expired Value] + [Stock Expiring 90 Days], _stock )
		displayFolder: Lookup\Stock
		lineageTag: 8dc0bfeb-62fd-4836-939a-b8d9e97c0c7e

		formatStringDefinition =
				VAR _unit = " ""of stock"""
				RETURN
				    "0.0%" & _unit

	/// Carrying amount of stock under IAS 2: the lower of cost and net realisable value, lot by lot. Cost as in Stock Cost Value. Net realisable value is the product's twelve-month net price without VAT over every warehouse, less its division's distribution-cost rate; expired lots have none. A product not sold in twelve months has no measurable net realisable value and stays at cost. Value.
	measure 'Stock Carrying Amount' =
			
			SUMX(
			    TREATAS( VALUES( FactStock[ProductId] ), DimProduct[ProductId] ),
			    VAR _net_price =
			        CALCULATE( [Net Price ex VAT Twelve Months], REMOVEFILTERS( DimOrgUnit ) )
			    VAR _distribution_cost =
			        LOOKUPVALUE(
			            DimDivision[DistributionCostRate],
			            DimDivision[DivisionId], CALCULATE( SELECTEDVALUE( DimProduct[DivisionId] ) )
			        )
			    VAR _nrv =
			        IF( NOT ISBLANK( _net_price ), MAX( 0, _net_price * ( 1 - _distribution_cost ) ) )
			    VAR _has_no_cost =
			        CALCULATE( NOT ISEMPTY( FactStock ), KEEPFILTERS( ISBLANK( FactStock[UnitCost] ) ) )
			    VAR _derived_cost =
			        IF( _has_no_cost, [Unit Cost Derived] )
			    RETURN
			        -- CALCULATE turns the article row into a filter, so SUMX walks that article's lots.
			        CALCULATE(
			            SUMX(
			                FactStock,
			                VAR _cost = COALESCE( FactStock[UnitCost], _derived_cost )
			                VAR _nrv_lot = IF( FactStock[DaysToExpiry] < 0, 0, _nrv )
			                RETURN
			                    FactStock[QuantityOnHand] * IF( ISBLANK( _nrv_lot ), _cost, MIN( _cost, _nrv_lot ) )
			            )
			        )
			)
		formatString: #,0
		displayFolder: Calculation Roots\Stock
		lineageTag: 464b4d50-c31a-4885-99b4-f4a5adf5ff99

	/// Stock on hand at cost. Value; a tooltip view of Stock Cost Value.
	measure 'Stock Cost' =
			
			[Stock Cost Value]
		displayFolder: Lookup\Stock
		lineageTag: a0d7d884-f57a-4791-82f9-d4f042a35b30

		formatStringDefinition =
				VAR _unit = ""
				RETURN
				    "#,0" & _unit

	/// Stock value at the source cost on the warehouse and product rows whose cost is more than twice, or less than half, the derived cost: the costs to correct at the source. The value stays inside Stock Cost Value; the source is the book and is not overridden. Value.
	measure 'Stock Cost Exception Value' =
			
			-- Derived cost once per article, and the stock value once per warehouse x article,
			-- joined and compared in memory. Filtering FactStock inside CALCULATE on a per-article
			-- variable cost one storage query per article, far slower.
			-- A derived cost of 0 against a positive ERP cost is an exception (ratio infinite);
			-- only an article with no derived cost at all cannot be tested.
			VAR _derived =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            TREATAS( VALUES( FactStock[ProductId] ), DimProduct[ProductId] ),
			            "@derived_cost", [Unit Cost Derived]
			        ),
			        "@product", DimProduct[ProductId] & "",
			        "@derived_cost", [@derived_cost]
			    )
			VAR _rows =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            CALCULATETABLE(
			                SUMMARIZE( FactStock, FactStock[ProductId], FactStock[WarehouseId], FactStock[UnitCost] ),
			                KEEPFILTERS( NOT ISBLANK( FactStock[UnitCost] ) )
			            ),
			            "@value", CALCULATE( SUM( FactStock[QuantityOnHand] ) ) * FactStock[UnitCost]
			        ),
			        "@product", FactStock[ProductId] & "",
			        "@erp_cost", FactStock[UnitCost],
			        "@value", [@value]
			    )
			VAR _exceptions =
			    FILTER(
			        NATURALINNERJOIN( _rows, _derived ),
			        NOT ISBLANK( [@derived_cost] )
			            && ( [@erp_cost] > 2 * [@derived_cost] || [@erp_cost] < 0.5 * [@derived_cost] )
			    )
			RETURN
			    SUMX( _exceptions, [@value] )
		formatString: #,0
		displayFolder: Stock\Cost Check
		lineageTag: ce5babb0-00bb-479e-acb4-a4e5327fd81a

	/// Stock on hand at cost (IAS 2 weighted average), without VAT, in every warehouse. Each row is valued at the source's running average cost for its warehouse and product; only where none is held does it fall back to Unit Cost Derived. A cost that looks wrong is kept, not overridden: Stock Cost Exception Value lists it. Value.
	measure 'Stock Cost Value' =
			
			VAR _erp_cost =
			    SUMX( FactStock, FactStock[QuantityOnHand] * FactStock[UnitCost] )
			VAR _fallback_cost =
			    -- Only the articles holding stock the ERP has no cost for. The context transition
			    -- over the TREATAS table filters DimProduct, so the derived cost is priced per article.
			    SUMX(
			        TREATAS(
			            CALCULATETABLE( VALUES( FactStock[ProductId] ), KEEPFILTERS( ISBLANK( FactStock[UnitCost] ) ) ),
			            DimProduct[ProductId]
			        ),
			        CALCULATE( SUM( FactStock[QuantityOnHand] ), KEEPFILTERS( ISBLANK( FactStock[UnitCost] ) ) )
			            * [Unit Cost Derived]
			    )
			RETURN
			    _erp_cost + _fallback_cost
		formatString: #,0
		displayFolder: Calculation Roots\Stock
		lineageTag: d6b462af-17a5-4193-a972-4d9242258bc2

	/// Days since the product's last sale. Days; a tooltip view of Product Days Since Last Sale, shown with ">" when the last sale is older than the history the model holds.
	measure 'Stock Days Since Last Sale' =
			
			[Product Days Since Last Sale]
		displayFolder: Lookup\Stock
		lineageTag: 9d0fa50d-1248-40ec-b021-d6a69ff55727

		formatStringDefinition =
				VAR _unit = " ""days"""
				-- at the cap the article has not sold since the history began: say "more than"
				VAR _limit = DATEDIFF( DATE( YEAR( TODAY() ) - 1, 1, 1 ), TODAY(), DAY )
				VAR _over = IF( SELECTEDMEASURE() >= _limit, """> """ )
				RETURN
				    _over & "#,0" & _unit

	/// Days until the next lot expires, counting only lots still in date that hold stock. Days. Expired lots are left out, so old remnants do not hide the next real expiry; they are in Stock Expired Value.
	measure 'Stock Days To Next Expiry' =
			
			-- Shelf-life warehouses only, as Stock Expired Value and the other expiry measures.
			CALCULATE(
			    MIN( FactStock[DaysToExpiry] ),
			    KEEPFILTERS( FactStock[InExpiryScope] = TRUE ),
			    KEEPFILTERS( FactStock[DaysToExpiry] >= 0 ),
