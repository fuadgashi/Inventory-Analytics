	/// Weeks the stock quantity lasts at this year's average weekly quantity sold. Weeks.
	measure 'Stock Weeks of Cover Quantity' =
			-- Weekly quantity this year: per week of working days since the article's first sale this year, not per
			-- week with a sale (AvgDay)
			VAR _weekly_quantity = AvgDay( [Sales Quantity Actual Year] ) * [Working Days per Week]
			RETURN
				DIVIDE( [Stock Quantity], _weekly_quantity, BLANK() )
		formatString: #,0.00000
		displayFolder: Stock\Balance
