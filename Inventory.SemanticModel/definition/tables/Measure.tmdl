/// The measure host: every business measure of the model, by subject folder.
table Measure
	lineageTag: 395b8708-c53a-4b08-9b45-c21bfe00a99f

	/// Number of warehouse and product rows whose source cost is more than twice, or less than half, the derived cost. A count.
	measure 'Cost Exceptions Count' =
			
			-- Derived cost once per article, and the stock value once per warehouse x article,
			-- joined and compared in memory. Filtering FactStock inside CALCULATE on a per-article
			-- variable cost one storage query per article, far slower.
			-- A derived cost of 0 against a positive ERP cost is an exception (ratio infinite);
			-- only an article with no derived cost at all cannot be tested.
			VAR _derived =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            TREATAS( VALUES( FactStock[ProductId] ), DimProduct[ProductId] ),
			            "@derived_cost", [Unit Cost Derived]
			        ),
			        "@product", DimProduct[ProductId] & "",
			        "@derived_cost", [@derived_cost]
			    )
			VAR _rows =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            CALCULATETABLE(
			                SUMMARIZE( FactStock, FactStock[ProductId], FactStock[WarehouseId], FactStock[UnitCost] ),
			                KEEPFILTERS( NOT ISBLANK( FactStock[UnitCost] ) )
			            ),
			            "@value", CALCULATE( SUM( FactStock[QuantityOnHand] ) ) * FactStock[UnitCost]
			        ),
			        "@product", FactStock[ProductId] & "",
			        "@erp_cost", FactStock[UnitCost],
			        "@value", [@value]
			    )
			VAR _exceptions =
			    FILTER(
			        NATURALINNERJOIN( _rows, _derived ),
			        NOT ISBLANK( [@derived_cost] )
			            && ( [@erp_cost] > 2 * [@derived_cost] || [@erp_cost] < 0.5 * [@derived_cost] )
			    )
			RETURN
			    -- One row per warehouse x article: UnitCost is a single value for each pair.
			    COUNTROWS( _exceptions )
		formatString: #,0
		displayFolder: Stock\Cost Check
		lineageTag: 31a39f37-2be9-4c36-abaa-12d034bed287

	/// Average cost per unit sold, weighted by quantity, goods only: service and allowance lines are left out, so unit cost times quantity gives back the cost of sales. Value per unit.
	measure 'Cost Price' =
			
			-- Quantity-weighted: value over quantity, so unit price x quantity gives back the
			-- money. An average over invoice lines counted a 1-piece line as much as a
			-- 1,000-piece one and leaned toward small, undiscounted orders.
			CALCULATE(
			    DIVIDE( SUMX( FactInvoiceLine, FactInvoiceLine[Quantity] * FactInvoiceLine[UnitCost] ), SUM( FactInvoiceLine[Quantity] ) ),
			    DimProduct[IsGoods] = TRUE,
			    DimDocumentType[IsSalesOut] = TRUE()
			)
		formatString: #,0.00
		displayFolder: Calculation Roots\Prices
		lineageTag: eb1fc954-b614-41cd-b662-b5acfd4127f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cost per unit sold over the rolling twelve months. Value per unit.
	measure 'Cost Price Twelve Months' =
			
			TwelMonth([Cost Price])
		formatString: #,0.00
		displayFolder: Prices\Product Prices
		lineageTag: 3aab486e-58f0-4611-b948-1ca7a4700c2c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Days of cover over remaining shelf life. At or above 1 the stock expires before it sells. On a product row the plain ratio; above product grain the average of the product ratios, because a ratio of totals pooled across products with very different shelf lives falls outside the range of the rows it summarises.
	measure 'Cover to Shelf Life Ratio' =
			
			IF(
			    HASONEVALUE( DimProduct[ProductName] ),
			    [Cover to Shelf Life Ratio Base],
			    AVERAGEX( VALUES( DimProduct[ProductName] ), [Cover to Shelf Life Ratio Base] )
			)
		formatString: 0%;-0%;0%
		displayFolder: Stock\Balance
		lineageTag: fe8a187e-9167-42e1-b503-d56e6509c465

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Working days of cover of the fresh stock over its remaining shelf life in working days, for one product. The single definition of the ratio. Expired quantity is left out: it has no shelf life to compare against.
	measure 'Cover to Shelf Life Ratio Base' =
			DIVIDE(
			    DIVIDE(
			        CALCULATE( [Stock Quantity Expiry Scope], KEEPFILTERS( ISBLANK( FactStock[DaysToExpiry] ) || FactStock[DaysToExpiry] >= 0 ) ),
			        [Sales Quantity Daily Average]
			    ),
			    -- Cover is in working days (sales per working day); the shelf life is in calendar
			    -- days, so it is put on the same basis: the calendar's share of working days.
			    [Shelf Life Days] * [Working Days Share]
			)
		formatString: 0%;-0%;0%
		isHidden
		displayFolder: Stock\Balance
		lineageTag: 1e74114a-28d9-42b4-87a8-d2c7c29f284c

	/// Latest expiry date among the lots in the shelf-life warehouses. Date.
	measure 'Expiry Date' =
			
			CALCULATE(
			    MAX(FactStock[ExpiryDate]),
			    KEEPFILTERS(FactStock[InExpiryScope] = TRUE)
			)
		formatString: dd/mm/yyyy
		displayFolder: Stock\Balance
		lineageTag: cc92e576-8c48-4212-a4c9-88a76425d551

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// Theme colour name for a days-to-expiry interval on the horizon chart: bad for Expired, neutral up to 60 days, good beyond. Never a hex, so it follows the theme.
	measure 'Expiry Interval Color' =
			RagColor(
			    SWITCH(
			        SELECTEDVALUE( ExpiryInterval[SortOrder] ),
			        -- Everything in it is already lost.
			        1, -1,
			        -- Real exposure, not yet loss: the theme's neutral colour.
			        2, 0,
			        3, 0,
			        -- Little at risk: 60+ days of remaining life clears the stock's
			        -- usual cover comfortably.
			        4, 1,
			        5, 1,
			        6, 1
			    ),
			    0
			)
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 7caa043c-4157-4031-b455-ce8480f3116e

		annotation PBI_FormatHint = {"isText":true}

	/// The product's expiry-risk band, judged on its fresh stock (lots not yet expired, or without a date): At Risk, Watch, Healthy, No Sales or No Expiry Date. Blank when the product has no fresh stock. Expired is not a product band but the expired lots, which the Band slicer shows separately. The one place the band thresholds live.
	measure 'Expiry Risk Band' =
			VAR _fresh_quantity =
			    CALCULATE(
			        SUM( FactStock[QuantityOnHand] ),
			        KEEPFILTERS( FactStock[InExpiryScope] = TRUE ),
			        KEEPFILTERS( ISBLANK( FactStock[DaysToExpiry] ) || FactStock[DaysToExpiry] >= 0 )
			    )
			VAR _shelf =
			    CALCULATE(
			        DIVIDE( SUMX( FactStock, FactStock[QuantityOnHand] * FactStock[DaysToExpiry] ), SUM( FactStock[QuantityOnHand] ) ),
			        KEEPFILTERS( NOT ISBLANK( FactStock[DaysToExpiry] ) && FactStock[DaysToExpiry] >= 0 ),
			        KEEPFILTERS( FactStock[InExpiryScope] = TRUE )
			    )
			VAR _cover = DIVIDE( _fresh_quantity, [Sales Quantity Daily Average] )
			-- Cover in working days against the shelf life in working days (the calendar's share of working days).
			VAR _ratio = DIVIDE( _cover, _shelf * [Working Days Share] )
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK( _fresh_quantity ) || _fresh_quantity <= 0, BLANK(),
			        -- The blank causes are tested first, and separately: BLANK() >= 0 is TRUE in DAX,
			        -- so an untested blank ratio falls through into the healthiest band.
			        -- No cover means no sales at all: dead stock, not a data gap.
			        ISBLANK( _cover ), "No Sales",
			        -- Stock that expires today has 0 days left: the ratio divides by zero and is blank,
			        -- but the date is not missing. NOT ISBLANK first - BLANK() = 0 is TRUE.
			        NOT ISBLANK( _shelf ) && _shelf = 0, "At Risk",
			        -- Cover exists but no shelf life: the fresh lots carry no expiry date.
			        ISBLANK( _ratio ), "No Expiry Date",
			        -- At Risk is cover at 80% of the shelf life or more: it may not sell in time. One band:
			        -- with expired stock in its own band, finer splits hold too few products to act on.
			        _ratio >= 0.8, "At Risk",
			        _ratio >= 0.4, "Watch",
			        "Healthy"
			    )
		displayFolder: Stock\Expiry
		lineageTag: 2fb6341c-5e18-4c7a-b507-fa7bfc3f1871

		annotation PBI_FormatHint = {"isText":true}

	/// Theme colour name for Expiry Risk Status: bad when the row shows expired pieces, otherwise the band's colour - bad for At Risk and No Sales, neutral for Watch and No Expiry Date, good for Healthy. Never a hex, so it follows the theme. Not for display.
	measure 'Expiry Risk Color' =
			VAR _selection = VALUES( ExpiryRiskBand[Band] )
			VAR _show_expired = "Expired" IN _selection
			VAR _show_fresh = COUNTROWS( EXCEPT( _selection, { "Expired" } ) ) > 0
			VAR _band =
			    IF(
			        _show_fresh,
			        IF( NOT _show_expired && COUNTROWS( _selection ) = 1, SELECTEDVALUE( ExpiryRiskBand[Band] ), [Expiry Risk Band] )
			    )
			VAR _has_expired =
			    _show_expired && NOT ISBLANK( CALCULATE(
			        SUM( FactStock[QuantityOnHand] ),
			        KEEPFILTERS( FactStock[InExpiryScope] = TRUE ),
			        KEEPFILTERS( FactStock[DaysToExpiry] < 0 )
			    ) )
			RETURN
			    RagColor(
			        IF(
			            _has_expired,
			            -1,
			            SWITCH( _band, "At Risk", -1, "Watch", 0, "Healthy", 1, "No Sales", -1, "No Expiry Date", 0 )
			        ),
			        0
			    )
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 1fc0f077-8a87-4ae1-8bcc-4e8351db5be4

		annotation PBI_FormatHint = {"isText":true}

	/// Numeric code of the product's band, 2 At Risk to 6 No Expiry Date, matching ExpiryRiskBand[SortOrder], for icon rules that take numbers. Not for display.
	measure 'Expiry Risk Severity' =
			
			SWITCH(
			    [Expiry Risk Band],
			    "Expired", 1,
			    "At Risk", 2,
			    "Watch", 3,
			    "Healthy", 4,
			    "No Sales", 5,
			    "No Expiry Date", 6,
			    BLANK()
			)
		formatString: 0
		isHidden
		displayFolder: Formatting\RAG Color
		lineageTag: 4dd4be15-3c45-4475-92a9-e327c1422204

	/// What the row holds, with a leading glyph: the expired pieces and/or the product's band for the fresh stock, as far as the Band slicer shows them. The glyph shapes encode severity, so the column reads without colour. Blank on total rows by design.
	measure 'Expiry Risk Status' =
			VAR _selection = VALUES( ExpiryRiskBand[Band] )
			VAR _show_expired = "Expired" IN _selection
			VAR _show_fresh = COUNTROWS( EXCEPT( _selection, { "Expired" } ) ) > 0
			VAR _expired =
			    IF( _show_expired && NOT ISBLANK( CALCULATE(
			        SUM( FactStock[QuantityOnHand] ),
			        KEEPFILTERS( FactStock[InExpiryScope] = TRUE ),
			        KEEPFILTERS( FactStock[DaysToExpiry] < 0 )
			    ) ), UNICHAR( 10006 ) & "  Expired" )
			VAR _band =
			    IF(
			        _show_fresh,
			        IF( NOT _show_expired && COUNTROWS( _selection ) = 1, SELECTEDVALUE( ExpiryRiskBand[Band] ), [Expiry Risk Band] )
			    )
			VAR _fresh =
			    IF( NOT ISBLANK( _band ), SWITCH(
			                _band,
			                -- Three-quarter and half circles step down in fill; U+25CF is avoided,
			                -- most fonts draw it bullet-size.
			                "At Risk", UNICHAR( 9685 ),
			                "Watch", UNICHAR( 9681 ),
			                "Healthy", UNICHAR( 10004 ),
			                "No Sales", UNICHAR( 8856 ),
			                "No Expiry Date", UNICHAR( 9676 )
			            ) & "  " & _band )
			RETURN
			    -- Blank unless a single article is in scope: a band has no meaning on a total row.
			    IF(
			        HASONEVALUE( DimProduct[ProductName] ),
			        IF( NOT ISBLANK( _expired ) && NOT ISBLANK( _fresh ), _expired & "  " & UNICHAR( 183 ) & "  " & _fresh, _expired & _fresh )
			    )
		displayFolder: Stock\Expiry
		lineageTag: a8b3cace-0c3a-4ffb-8c9c-df5479218576

		annotation PBI_FormatHint = {"isText":true}

	/// Average net selling price per unit sold, without VAT and after discounts, weighted by quantity. Value per unit.
	measure 'Net Price ex VAT' =
			
			-- Quantity-weighted: value over quantity, so unit price x quantity gives back the
			-- money. An average over invoice lines counted a 1-piece line as much as a
			-- 1,000-piece one and leaned toward small, undiscounted orders.
			CALCULATE(
			    DIVIDE( SUMX( FactInvoiceLine, FactInvoiceLine[Quantity] * FactInvoiceLine[NetPrice] * FactInvoiceLine[ExVatFactor] ), SUM( FactInvoiceLine[Quantity] ) ),
			    DimDocumentType[IsSalesOut] = TRUE()
			)
		formatString: #,0.00
		displayFolder: Calculation Roots\Prices
		lineageTag: ca515ede-63f8-4de4-9354-4b56a5f6859e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Net price per unit without VAT over the rolling twelve months. Value per unit.
	measure 'Net Price ex VAT Twelve Months' =
			
			TwelMonth([Net Price ex VAT])
		formatString: #,0
		displayFolder: Prices\Product Prices
		lineageTag: d12645b8-d265-4695-b5b2-d1fb3469f9d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Quantity still to order: the sales expected for the rest of the year less the stock on hand. Units; negative when stock already covers the rest of the year.
	measure 'Order Requirement' =
			
			[Sales Quantity Actual Year YTG] - [Stock Quantity]
		formatString: #,0
		displayFolder: Stock\Balance
		lineageTag: fb76ceca-91a5-4457-9ebb-02a1bcd0e032

	/// Days since the product's last sale, over every warehouse and customer, up to today. Where the history holds no sale, the days since the history begins (1 January of last year). Days.
	measure 'Product Days Since Last Sale' =
			
			-- The history in FactInvoiceLine starts on 1 January of last year (the source query's window),
			-- so "never sold" can only mean "not sold since then".
			VAR _start = DATE( YEAR( TODAY() ) - 1, 1, 1 )
			VAR _last_date =
			    CALCULATE(
			        MAX( FactInvoiceLine[Date] ),
			        DimDocumentType[IsSalesOut] = TRUE,
			        REMOVEFILTERS( DimOrgUnit ),
			        REMOVEFILTERS( DimDate )
			    )
			VAR _has_stock = NOT ISEMPTY( FactStock )
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT ISBLANK( _last_date ), DATEDIFF( _last_date, TODAY(), DAY ),
			        _has_stock, DATEDIFF( _start, TODAY(), DAY )
			    )
		formatString: #,0
		displayFolder: Calculation Roots\Stock
		lineageTag: 0705ed18-35b0-43ca-b4d5-ecd9e9497035

	/// Average cost per unit bought, after discounts, without VAT, weighted by quantity. Value per unit. The first fallback for stock cost where the source holds none.
	measure 'Purchase Net Price ex VAT' =
			
			CALCULATE(
			    DIVIDE( SUMX( FactInvoiceLine, FactInvoiceLine[Quantity] * FactInvoiceLine[NetPrice] * FactInvoiceLine[ExVatFactor] ), SUM( FactInvoiceLine[Quantity] ) ),
			    DimDocumentType[IsPurchase] = TRUE()
			)
		formatString: #,0.00
		isHidden
		displayFolder: Calculation Roots\Prices
		lineageTag: 36746f2c-cea3-44fe-a775-e8cf84ff6283

	/// Average regular selling price per unit sold, with VAT and before discounts, weighted by quantity. Value per unit.
	measure 'Regular Price' =
			
			-- Quantity-weighted: value over quantity, so unit price x quantity gives back the
			-- money. An average over invoice lines counted a 1-piece line as much as a
			-- 1,000-piece one and leaned toward small, undiscounted orders.
			CALCULATE(
			    DIVIDE( SUMX( FactInvoiceLine, FactInvoiceLine[Quantity] * FactInvoiceLine[DocumentPrice] ), SUM( FactInvoiceLine[Quantity] ) ),
			    DimDocumentType[IsSalesOut] = TRUE()
			)
		formatString: #,0.00
		displayFolder: Calculation Roots\Prices
		lineageTag: dc373eca-c2f3-4407-9027-251d3b76b044

	/// Regular price per unit over the rolling twelve months. Value per unit.
	measure 'Regular Price Twelve Months' =
			
			TwelMonth([Regular Price])
		formatString: #,0.00
		displayFolder: Prices\Product Prices
		lineageTag: 4f2ea0cc-5d21-4e54-bba6-fe29e9bccd44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Quantity sold on sales-out documents. Units.
	measure 'Sales Quantity' =
			
			CALCULATE(
				SUM(FactInvoiceLine[Quantity]),
			    DimDocumentType[IsSalesOut] = TRUE
			)
		displayFolder: Calculation Roots\Sales
		lineageTag: 62af8b09-8be3-4006-a864-8dea09f3f0bb

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

	/// Quantity sold this year to date: the date slicers' window within this year, cut at today (1 January to today when no slicer is set). Units.
	measure 'Sales Quantity Actual Year' =
			
			YearToDay([Sales Quantity])
		displayFolder: Sales\Quantity
		lineageTag: 958d1833-5630-4e7b-91b2-bc4753ebbbcf

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Average quantity sold per working day this year, counted from the product's first sale this year (AvgDay). Units per working day.
	measure 'Sales Quantity Actual Year Daily Average' =
			-- Per working day since the first sale, not per day WITH a sale: counting only the days
			-- with a sale would overstate the forecast of the articles with no sales last year.
			AvgDay( [Sales Quantity Actual Year] )
		displayFolder: Sales\Quantity
		lineageTag: c189a5ef-0e26-4afc-875b-1bb6e7b2551e

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Quantity expected to sell for the rest of the year: this year's pace per working day, times the working days left, shaped by last year's seasonality. A product with no sales this year takes last year's rest of the year. Units.
	measure 'Sales Quantity Actual Year YTG' =
			-- Rest of the year: this year's average per working day (AvgDay, from the product's first sale)
			-- x remaining working days x last year's season. No sales this year: last year's rest of the year.
			-- Season: last year's average per working day after today's date / up to it, company-wide (ALL).
			VAR _season =
			    CALCULATE(
			        DIVIDE(
			            DIVIDE( [Sales Quantity Prior Year YTG], YearToGo( PrevYear( SUM( DimDate[Working Day] ) ) ) ),
			            DIVIDE( [Sales Quantity Prior Year YTD], YearToDay( PrevYear( SUM( DimDate[Working Day] ) ) ) )
			        ),
			        ALL()
			    )
			RETURN
			    IF(
			        [Sales Quantity Actual Year] > 0,
			        [Sales Quantity Actual Year Daily Average] * [Working Days Remaining] * _season,
			        [Sales Quantity Prior Year YTG]
			    )
		displayFolder: Sales\Quantity
		lineageTag: 2ed841fa-fcc9-4141-a7bd-badba4596402

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Average quantity sold per working day over the rolling twelve months, counted from the product's first sale in that window (AvgDay), not per day with a sale. Units per working day. Feeds days of cover and the expiry-risk band.
	measure 'Sales Quantity Daily Average' =
			-- Per working day (calendar) since the first sale, not per day WITH a sale: AvgDay skipped the
			-- days without one, so an article sold on a few days read many times its real daily rate and
			-- its stock looked like far fewer days of cover than it holds.
			AvgDay( [Sales Quantity Twelve Months] )
		displayFolder: Sales\Quantity
		lineageTag: 4285a29d-a9e5-461b-890f-8e4fdb9f0b93

		formatStringDefinition = NumberFormat(SELECTEDMEASURE(), FALSE)

		changedProperty = IsHidden

	/// Average quantity sold per working day over the rolling twelve months, shown only where the shelf-life warehouses hold stock. Units per working day.
	measure 'Sales Quantity Daily Average Expiry Scope' = ```
			
			VAR _stock = [Stock Quantity Expiry Scope]
			VAR _average = [Sales Quantity Daily Average]
			RETURN 
			    IF(ISBLANK(_stock) || _stock <= 0, BLANK(), _average)
			```
		formatString: #,0
		displayFolder: Stock\Balance
		lineageTag: da42955f-d9c1-4421-a89d-628096d2ad96

