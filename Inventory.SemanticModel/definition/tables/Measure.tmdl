	/// Stock quantity in the warehouses that track shelf life. Units. Follows the Band slicer: with Expired selected it counts the expired lots only, with any other band the lots not yet expired or without a date; with nothing selected, and on pages without that slicer, all of it.
	measure 'Stock Quantity Expiry Scope' =
			VAR _selection = VALUES( ExpiryRiskBand[Band] )
			VAR _show_expired = "Expired" IN _selection
			VAR _show_fresh = COUNTROWS( EXCEPT( _selection, { "Expired" } ) ) > 0
			VAR _all =
			    CALCULATE(
			        SUM( FactStock[QuantityOnHand] ),
			        KEEPFILTERS( FactStock[InExpiryScope] = TRUE )
			    )
			VAR _result =
			    SWITCH(
			        TRUE(),
			        _show_expired && _show_fresh, _all,
			        _show_expired,
			            CALCULATE(
			        SUM( FactStock[QuantityOnHand] ),
			        KEEPFILTERS( FactStock[InExpiryScope] = TRUE ),
			        KEEPFILTERS( FactStock[DaysToExpiry] < 0 )
			    ),
			        CALCULATE(
			            SUM( FactStock[QuantityOnHand] ),
			            KEEPFILTERS( FactStock[InExpiryScope] = TRUE ),
			            KEEPFILTERS( ISBLANK( FactStock[DaysToExpiry] ) || FactStock[DaysToExpiry] >= 0 )
			        )
			    )
			RETURN
			    IF( ISBLANK( _result ) || _result <= 0, BLANK(), _result )
		formatString: #,0
		displayFolder: Calculation Roots\Stock
		lineageTag: e7d944db-c5ff-4f72-9520-8fbd3570c1df

	/// Stock on hand at the regular selling price, before discounts: each product's quantity times one price per product, its twelve-month regular price over every warehouse. A management view, not a book value. Value.
	measure 'Stock Regular Price Value' =
			
			-- Iterates the articles in stock, not the stock rows: a row-level context transition
			-- would carry the row's warehouse to FactInvoiceLine and price every warehouse at its own sales,
			-- so warehouses without sales would be 0.
			SUMX(
			    TREATAS( VALUES( FactStock[ProductId] ), DimProduct[ProductId] ),
			    CALCULATE( SUM( FactStock[QuantityOnHand] ) )
			        * CALCULATE( [Regular Price Twelve Months], REMOVEFILTERS( DimOrgUnit ) )
			)
		formatString: #,0
		displayFolder: Calculation Roots\Stock
		lineageTag: 7885f0b4-7263-4ccd-9f91-a71414ffe822

