/// Document types, with the flags that say which documents are sales and which are purchases.
table DimDocumentType
	lineageTag: b8918eb5-2f70-465d-bcb6-0c6e09337739

	/// Document type code.
	column DocumentTypeId
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
		lineageTag: 875a6dcf-a4e4-4961-93e7-fc0c7105f784
		summarizeBy: none
		sourceColumn: DocumentTypeId

		annotation SummarizationSetBy = Automatic

	/// Document type name.
	column DocumentTypeName
		dataType: string
		isAvailableInMdx: false
		lineageTag: b6034870-f389-4b67-bb61-fd532ba84ac7
		isDefaultLabel
		summarizeBy: none
		sourceColumn: DocumentTypeName

		annotation SummarizationSetBy = Automatic

	/// TRUE for document types that move goods out to a customer. Every sales measure filters on it.
	column IsSalesOut
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: 8634d32f-3f6f-4adb-aa29-ea66494b0f79
		summarizeBy: none
		sourceColumn: IsSalesOut

		annotation SummarizationSetBy = Automatic

	/// TRUE for document types that bring goods in from a supplier. Not the complement of IsSalesOut: most types are neither.
	column IsPurchase
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		isAvailableInMdx: false
		lineageTag: f8c5e252-85b2-461a-b804-edb1d6fbab8e
		summarizeBy: none
		sourceColumn: IsPurchase

		annotation SummarizationSetBy = Automatic

	partition DimDocumentType = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    // Document types, with the sales and purchase flags kept in the source.
				    Source =
				        Sql.Database(
				            pServer,
				            pDatabase,
				            [
				                Query = "
				                SELECT
				                    t.DocumentTypeId,
				                    t.DocumentTypeName,
				                    -- a document type the source adds arrives unflagged and counts in no total until it is flagged
				                    t.IsSalesOut,
				                    t.IsPurchase
				                FROM inv.DocumentType t
				                ",
				                CommandTimeout = #duration(0, 1, 0, 0)
				            ]
				        ),
				    Keyed = Table.AddKey(Source, {"DocumentTypeId"}, true),
				    Typed = Table.TransformColumnTypes(
				        Keyed,
				        {
				            {"IsSalesOut", type logical},
				            {"IsPurchase", type logical}
				        }
				    )
				in
				    Typed
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
