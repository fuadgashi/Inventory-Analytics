model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Model

	annotation PBI_QueryGroupOrder = 0

queryGroup Fact

	annotation PBI_QueryGroupOrder = 2

queryGroup Dimension

	annotation PBI_QueryGroupOrder = 3

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 4

annotation PBI_QueryOrder = ["Measure", "FactStock", "FactInvoiceLine", "DimProduct", "DimDivision", "DimOrgUnit", "DimDocumentType", "ExpiryRiskBand", "ExpiryInterval", "DimDate", "Labels", "LabelMeasures", "pServer", "pDatabase"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DaxQueryView_Desktop","CalcGroup","TMDLView_Desktop","WebModelingEdit","DevMode","MCP-PBIModeling"]

annotation __TEdtr = 1

ref table FactStock
ref table FactInvoiceLine
ref table DimProduct
ref table DimDivision
ref table DimOrgUnit
ref table DimDocumentType
ref table ExpiryRiskBand
ref table ExpiryInterval
ref table DimDate
ref table Measure
